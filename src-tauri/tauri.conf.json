{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "King Of Focus",
  "mainBinaryName": "king-of-focus",
  "version": "0.1.61",
  "identifier": "com.kingoffocus.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "King Of Focus",
        "width": 1240,
        "height": 830,
        "minWidth": 1060,
        "minHeight": 690,
        "center": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "hud",
        "url": "hud.html",
        "title": "King Of Focus",
        "width": 272,
        "height": 122,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "toast",
        "url": "toast.html",
        "title": "King Of Focus",
        "width": 470,
        "height": 168,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "sleep",
        "url": "sleep.html",
        "title": "睡眠时间",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}