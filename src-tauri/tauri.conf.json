{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "King of Focus",
  "mainBinaryName": "king-of-focus",
  "version": "0.0.1",
  "identifier": "com.kingoffocus.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "King of Focus",
        "width": 1240,
        "height": 830,
        "minWidth": 1060,
        "minHeight": 690,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
