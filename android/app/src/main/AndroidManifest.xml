<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取"当前前台是哪个应用"：Android 没有跨进程枚举接口，只能靠使用情况访问 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 兜底遮罩（当拦截 Activity 被系统限制时使用悬浮窗） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 保活：请求「忽略电池优化」，否则 Doze 会把守护服务冻住 -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- 常驻守护服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Shizuku：拿到 ADB 级 shell 权限（用户自己授权，Shizuku 会把权限跑在 shell 用户下） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 自动更新：下载 APK 需要网络；安装需要"未知来源"授权（Android 8+ 按应用授予） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 列出可被拦截的应用（应用选择器） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".KofApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kof">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kof">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            锁机遮罩：**刻意**和主界面共用任务栈（不设 taskAffinity）。
            这样从桌面点开本应用时，任务栈顶就是遮罩，用户回不到主界面去关掉自律。
            也不进最近任务：它不该是一张"可以划掉"的卡片。
        -->
        <activity
            android:name=".ui.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Kof.Block"
            android:turnScreenOn="true" />

        <service
            android:name=".service.GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="self_discipline_guard" />
        </service>

        <!-- 无障碍：前台识别 + 全局回桌面 + 强制模式防绕过 -->
        <service
            android:name=".service.KofAccessibility"
            android:exported="true"
            android:label="@string/acc_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Shizuku 用户服务：跑在 shell 身份下，只对外提供一个 exec 方法 -->
        <service
            android:name=".shell.ShellService"
            android:exported="false" />

        <!-- 更新包：下载到 cacheDir/updates，用 FileProvider 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 保活第二条通道：JobScheduler 周期任务（部分 ROM 只放行 Job 不放行 Alarm） -->
        <service
            android:name=".service.GuardJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 心跳：服务被系统清掉后把它拉回来 -->
        <receiver
            android:name=".service.GuardHeartbeat"
            android:exported="false" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
